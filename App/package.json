{
  "name": "neural-network-from-scratch-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-404.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:language": "node --experimental-strip-types scripts/check-language.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --experimental-strip-types scripts/test-navigation.e2e.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "framer-motion": "^12.4.7",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "mafs": "^0.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "shiki": "^2.3.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "playwright": "^1.64.0",
    "prettier": "^3.5.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
